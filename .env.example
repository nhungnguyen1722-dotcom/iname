# PostgreSQL. Local example uses database `iname`.
# Hosted example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Do not commit real passwords.
DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@127.0.0.1:5433/iname"

# Random string, at least 32 characters. Used to sign the admin session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# Used only when no admin account exists yet. Minimum 12 characters.
# Remove or change this after the first successful seed.
ADMIN_EMAIL="admin@iname.local"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-password"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
